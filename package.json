{
 "name": "sombra",
 "version": "0.1.39",
 "private": true,
 "type": "module",
 "scripts": {
  "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
  "build": "tsc --noEmit && vite build",
  "prebuild": "node prepare-build.mjs",
  "start": "node tauri-dev.mjs",
  "tauri": "node node_modules/@tauri-apps/cli/tauri.js",
  "tauri:dev": "node tauri-dev.mjs",
  "release:windows": "node release-build.mjs",
  "check:release": "node scripts/check-release-config.mjs",
  "check:fsd": "node scripts/check-fsd.mjs",
  "ui:add": "node scripts/ui-add.mjs",
  "lint": "eslint .",
  "lint:fix": "eslint . --fix",
  "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{mjs,json}\"",
  "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{mjs,json}\"",
  "check:code": "npm run lint && npm run check:fsd",
  "test:src": "node --experimental-strip-types --test \"src/**/*.test.mjs\"",
  "verify:release": "node scripts/verify-release.mjs",
  "test:updater": "node --experimental-strip-types --test check-updater.mjs",
  "test:avatars": "node --test check-avatar-assets.mjs"
 },
 "dependencies": {
  "@assistant-ui/generative-ui": "0.0.12",
  "@assistant-ui/react": "0.15.36",
  "@base-ui/react": "^1.9.0",
  "@emoji-mart/data": "^1.2.1",
  "@fontsource-variable/geist": "^5.3.0",
  "@fontsource-variable/geist-mono": "^5.3.0",
  "@fontsource-variable/inter": "^5.3.0",
  "@fontsource-variable/jetbrains-mono": "^5.3.0",
  "@paper-design/shaders-react": "0.0.82",
  "@radix-ui/react-context-menu": "^2.4.1",
  "@radix-ui/react-dropdown-menu": "^2.2.1",
  "@radix-ui/react-slot": "^1.5.0",
  "@sapphi-red/web-noise-suppressor": "0.4.1",
  "@shadcn/react": "^0.3.1",
  "@tailwindcss/vite": "^4.3.5",
  "@tauri-apps/api": "^2",
  "@tauri-apps/plugin-opener": "^2",
  "class-variance-authority": "^0.7.1",
  "cn": "^0.5.2",
  "dequal": "2.0.3",
  "fflate": "^0.8.3",
  "livekit-client": "2.25.0",
  "lucide-react": "^1.72.0",
  "radix-ui": "^1.8.1",
  "react": "^19.1.0",
  "react-dom": "^19.1.0",
  "react-easy-crop": "6.2.5",
  "react-markdown": "10.1.0",
  "react-resizable-panels": "^4.24.1",
  "remark-gfm": "4.0.1",
  "shadcn": "^4.23.0",
  "sonner": "^2.0.8",
  "tailwindcss": "^4.3.5",
  "tw-animate-css": "^1.4.0",
  "zustand": "^5.1.0"
 },
 "devDependencies": {
  "@eslint/js": "^10.0.1",
  "@tauri-apps/cli": "^2",
  "@types/node": "^26.6.6",
  "@types/react": "^19.1.8",
  "@types/react-dom": "^19.1.6",
  "@vitejs/plugin-react": "^6.0.2",
  "eslint": "^10.15.0",
  "eslint-config-prettier": "^10.1.8",
  "eslint-plugin-react-hooks": "^7.1.1",
  "eslint-plugin-react-refresh": "^0.5.8",
  "globals": "^17.14.0",
  "prettier": "^3.10.1",
  "prettier-plugin-tailwindcss": "^0.8.1",
  "typescript": "~6.0.3",
  "typescript-eslint": "^8.73.0",
  "vite": "^8.0.16"
 }
}
