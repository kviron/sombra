root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Код проекта намеренно набран одним пробелом отступа и без пробелов внутри фигурных скобок.
[*.{ts,tsx,mjs,js,json,css}]
indent_style = space
indent_size = 1

[*.md]
trim_trailing_whitespace = false
