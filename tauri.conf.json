{
  "productName": "Sombra",
  "version": "0.1.14",
  "identifier": "local.mines.chat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "decorations": false,
        "dragDropEnabled": false,
        "width": 1080,
        "title": "Sombra",
        "center": true,
        "height": 720,
        "minWidth": 720,
        "label": "main",
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyRTI0RDBFRkNERjRGNTkKUldSWlQ5LzhEazNpSXFmV2YyR0k5MGVFNjMzQzl6UmhNK3VZNlM3eEFrRTl5TnBqNitPbjlidHQK",
      "endpoints": [
        "https://sombra.mi-nerva.ru/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
